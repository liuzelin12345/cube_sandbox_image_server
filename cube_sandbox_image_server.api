syntax = "v1"

info (
	title:   "Cube Sandbox Image Server API"
	desc:    "自定义沙箱工具创建与镜像同步服务"
	author:  "lzl"
	version: "v1"
)

type Tag {
	// [必填] 标签键
	Key string `json:"key"`
	// [必填] 标签值
	Value string `json:"value"`
}

type VpcConfiguration {
	// [可选] 缺省值由 internal/config/defaults.go 统一定义
	SubnetIds []string `json:"subnetIds,optional"`
	// [可选] 缺省值由 internal/config/defaults.go 统一定义
	SecurityGroupIds []string `json:"securityGroupIds,optional"`
}

type NetworkConfiguration {
	// [可选] 缺省值由 internal/config/defaults.go 统一定义；可选 PUBLIC / VPC / SANDBOX
	NetworkMode string `json:"networkMode,optional,options=[PUBLIC,VPC,SANDBOX]"`
	// [可选] VPC 缺省值由 internal/config/defaults.go 统一定义，其他模式不得传入
	VpcConfig VpcConfiguration `json:"vpcConfig,optional"`
}

type EnvironmentVariable {
	// [必填] 环境变量名
	Name string `json:"name"`
	// [必填] 环境变量值
	Value string `json:"value"`
}

type PortConfiguration {
	// [必填] 端口名称
	Name string `json:"name"`
	// [必填] 目前仅支持 TCP
	Protocol string `json:"protocol,options=[TCP]"`
	// [必填] 1-65535
	Port int64 `json:"port"`
}

type ResourceConfiguration {
	// [可选] 缺省值由 internal/config/defaults.go 统一定义
	CPU string `json:"cpu,optional"`
	// [可选] 缺省值由 internal/config/defaults.go 统一定义
	Memory string `json:"memory,optional"`
}

type HttpGetAction {
	// [可选] 缺省值由 internal/config/defaults.go 统一定义
	Path string `json:"path,optional"`
	// [可选] 缺省值由 internal/config/defaults.go 统一定义
	Port int64 `json:"port,optional"`
	// [可选] 缺省值由 internal/config/defaults.go 统一定义
	Scheme string `json:"scheme,optional,options=[HTTP,HTTPS]"`
}

type ProbeConfiguration {
	// [可选] HTTP GET 探针，字段默认值见 HttpGetAction
	HttpGet HttpGetAction `json:"httpGet,optional"`
	// [可选] 以下缺省值由 internal/config/defaults.go 统一定义
	ReadyTimeoutMs   int64 `json:"readyTimeoutMs,optional"`
	ProbeTimeoutMs   int64 `json:"probeTimeoutMs,optional"`
	ProbePeriodMs    int64 `json:"probePeriodMs,optional"`
	SuccessThreshold int64 `json:"successThreshold,optional"`
	FailureThreshold int64 `json:"failureThreshold,optional"`
}

type DnsConfiguration {
	// [可选] 默认为空数组/不传
	Servers []string `json:"servers,optional"`
	// [可选] 默认为空数组/不传
	Searches []string `json:"searches,optional"`
	// [可选] 默认为空数组/不传
	Options []string `json:"options,optional"`
}

type CustomConfiguration {
	// [必填] 可拉取的运行镜像地址
	Image string `json:"image"`
	// [可选] 缺省值由 internal/config/defaults.go 统一定义；可选 enterprise / personal
	ImageRegistryType string `json:"imageRegistryType,optional,options=[enterprise,personal]"`
	// [可选] 默认为空数组；创建时从镜像 Entrypoint 获取，为空时回退到 Cmd
	Command []string `json:"command,optional"`
	// [可选] 默认为空数组/不传
	Args []string `json:"args,optional"`
	// [可选] 默认为空数组/不传
	Env []EnvironmentVariable `json:"env,optional"`
	// [可选] 缺省端口由 internal/config/defaults.go 统一定义
	Ports []PortConfiguration `json:"ports,optional"`
	// [可选] CPU 和 Memory 缺省值由 internal/config/defaults.go 统一定义
	Resources ResourceConfiguration `json:"resources,optional"`
	// [可选] 缺省探针由 internal/config/defaults.go 统一定义
	Probe ProbeConfiguration `json:"probe,optional"`
	// [可选] 三个子字段都为空时不传 DNSConfig
	DnsConfig DnsConfiguration `json:"dnsConfig,optional"`
}

type CosStorageSource {
	// [可选] COS 访问域名，缺省值由 internal/config/defaults.go 统一定义
	Endpoint string `json:"endpoint,optional"`
	// [可选] COS Bucket 名称，缺省值由 internal/config/defaults.go 统一定义
	BucketName string `json:"bucketName,optional"`
	// [可选] Bucket 内路径，必须以 / 开头；缺省值由 internal/config/defaults.go 统一定义
	BucketPath string `json:"bucketPath,optional"`
}

type StorageSource {
	// [可选] 默认使用 COS 存储源
	Cos CosStorageSource `json:"cos,optional"`
}

type StorageMount {
	// [可选] 缺省值由 internal/config/defaults.go 统一定义
	Name string `json:"name,optional"`
	// [可选] 默认使用 COS 存储源
	StorageSource StorageSource `json:"storageSource,optional"`
	// [可选] 必须以 / 开头，缺省值由 internal/config/defaults.go 统一定义
	MountPath string `json:"mountPath,optional"`
	// [可选] 缺省值由 internal/config/defaults.go 统一定义
	ReadOnly *bool `json:"readOnly,optional"`
}

type CreateSandboxToolRequest {
	// [必填] Tool 名称，同一 AppId 下必须唯一
	ToolName string `json:"toolName"`
	// [可选] 缺省值由 internal/config/defaults.go 统一定义
	Description string `json:"description,optional"`
	// [可选] 缺省值由 internal/config/defaults.go 统一定义，最大 24h
	DefaultTimeout string `json:"defaultTimeout,optional"`
	// [可选] 幂等 Token，默认为空/不传；同一次创建重试时应保持不变
	ClientToken string `json:"clientToken,optional"`
	// [可选] 缺省值由 internal/config/defaults.go 统一定义
	RoleArn string `json:"roleArn,optional"`
	// [可选] 缺省值由 internal/config/defaults.go 统一定义
	Persistent *bool `json:"persistent,optional"`
	// [可选] 默认为空数组/不传
	Tags []Tag `json:"tags,optional"`
	// [可选] 缺省网络由 internal/config/defaults.go 统一定义
	NetworkConfiguration NetworkConfiguration `json:"networkConfiguration,optional"`
	// [可选] 默认不挂载卷；省略或传空数组时不向云端传递挂载配置
	StorageMounts []StorageMount `json:"storageMounts,optional"`
	// [必填] 自定义运行配置，其中 image 必填
	CustomConfiguration CustomConfiguration `json:"customConfiguration"`
}

type CreateSandboxToolResponse {
	Accepted     bool   `json:"accepted"`
	Status       string `json:"status,optional"`
	StatusReason string `json:"statusReason,optional"`
	ErrorCode    string `json:"errorCode,optional"`
	ErrorMessage string `json:"errorMessage,optional"`
	ToolId       string `json:"toolId,optional"`
	RequestId    string `json:"requestId,optional"`
}

type GetSandboxToolStatusRequest {
	// [必填] 创建接口返回的 Tool ID
	ToolId string `form:"toolId"`
}

type GetSandboxToolStatusResponse {
	ToolId       string `json:"toolId"`
	Status       string `json:"status"`
	StatusReason string `json:"statusReason,optional"`
	RequestId    string `json:"requestId,optional"`
}

type SyncImageRequest {
	SrcHub string `form:"srcHub"`
	DstHub string `form:"dstHub"`
	Group  string `form:"group"`
	Image  string `form:"image"`
	Tag    string `form:"tag"`
}

type SyncImageData {
	Image   string `json:"image"`
	NewSync bool   `json:"newSync"`
	Time    int64  `json:"time"`
}

type SyncImageResponse {
	Code   int64         `json:"code"`
	Data   SyncImageData `json:"data"`
	Status string        `json:"status"`
}

@server (
	prefix: /api/v1
	group:  cubeSandboxImage
)
service cube_sandbox_image_server-api {
	@doc "创建腾讯云自定义沙箱工具"
	@handler CreateSandboxToolHandler
	post /sandbox/tools (CreateSandboxToolRequest) returns (CreateSandboxToolResponse)

	@doc "查询腾讯云自定义沙箱工具状态"
	@handler GetSandboxToolStatusHandler
	get /sandbox/tools/status (GetSandboxToolStatusRequest) returns (GetSandboxToolStatusResponse)

	@doc "将镜像从源镜像仓库同步到目标镜像仓库"
	@handler SyncImageHandler
	get /images/sync (SyncImageRequest) returns (SyncImageResponse)
}

@server (
	group: health
)
service cube_sandbox_image_server-api {
	@doc "Kubernetes Readiness 探针"
	@handler ReadinessHandler
	get /readiness
}

