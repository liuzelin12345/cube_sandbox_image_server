# 必填：腾讯云 AGS 凭证
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# 可选：默认值见 etc/cubesandboximageserver-api.yaml
TENCENTCLOUD_REGION=ap-shanghai
TENCENTCLOUD_ENDPOINT=ags.tencentcloudapi.com

# 必填：Registry V2 Basic/Bearer 鉴权使用的基础凭证
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# 可选：默认为 http://172.20.208.115/sync/image
IMAGE_SYNC_ENDPOINT=http://172.20.208.115/sync/image
